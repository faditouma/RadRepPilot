{
  "name": "radreppilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "extract:acr": "node scripts/extract-acr-pdfs.mjs",
    "generate:acr-topics": "node scripts/generate-acr-topics.mjs",
    "convert:acr": "node scripts/convert-acr-raw-to-curated.mjs",
    "acr:clean": "node scripts/acr/clean-acr-procedure-rows.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "report:acr-quality": "node scripts/generate-acr-quality-reports.mjs",
    "education:server": "node --env-file-if-exists=.env.local server/app.mjs",
    "education:preview": "EDUCATION_LOCAL_PREVIEW=true node server/app.mjs",
    "education:import": "node scripts/education/import.mjs",
    "education:seed": "node scripts/education/seed.mjs",
    "education:test": "node --test server/*.test.mjs",
    "build:ohif": "node scripts/dicom/build-ohif.mjs",
    "build:ohif-preview": "node scripts/dicom/package-preview.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
